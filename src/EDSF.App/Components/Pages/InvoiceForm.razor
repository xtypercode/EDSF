@page "/faturas/novo"
@page "/faturas/{id:int}/editar"
@inject HttpClient Http
@inject NavigationManager Nav

<div class="page-title">
    <span><i class="bi bi-receipt me-2"></i>@(id == 0 ? "NOVA FATURA" : "EDITAR FATURA")</span>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

<div class="card">
    <div class="card-body">
        <form>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Tipo Documento</label>
                    <select @bind="item.DocumentType" class="form-select">
                        <option value="FT">Factura</option>
                        <option value="FR">Factura Recibo</option>
                        <option value="FS">Factura Simplificada</option>
                        <option value="NC">Nota de Crédito</option>
                        <option value="ND">Nota de Débito</option>
                        <option value="PF">Pro Forma</option>
                        <option value="RE">Recibo</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Série</label>
                    <input @bind="item.Series" class="form-control" placeholder="Auto se vazio" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Moeda</label>
                    <select @bind="item.Currency" class="form-select">
                        <option value="AOA">Kwanza (AOA)</option>
                        <option value="USD">Dólar (USD)</option>
                        <option value="EUR">Euro (EUR)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cliente ID</label>
                    <input @bind="item.CustomerId" type="number" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Data</label>
                    <input @bind="item.Date" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Data de Vencimento</label>
                    <input @bind="item.DueDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Estado</label>
                    <select @bind="item.Status" class="form-select">
                        <option value="Draft">Rascunho</option>
                        <option value="Pending">Pendente</option>
                        <option value="Paid">Paga</option>
                        <option value="Cancelled">Cancelada</option>
                        <option value="Annulled">Anulada</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Câmbio</label>
                    <input @bind="item.ExchangeRate" type="number" step="0.000001" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Imposto Selo</label>
                    <input @bind="item.StampTax" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Retenção na Fonte</label>
                    <input @bind="item.WithholdingTax" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Desconto Total</label>
                    <input @bind="item.DiscountAmount" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Notas</label>
                    <textarea @bind="item.Notes" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <h5 class="mt-4 mb-3">Linhas</h5>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Descrição</th>
                        <th>Código</th>
                        <th>Qtd</th>
                        <th>Preço Uni.</th>
                        <th>Desc.</th>
                        <th>Taxa IVA</th>
                        <th>Isenção</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in item.Lines.ToList())
                    {
                        <tr>
                            <td><input @bind="line.Description" class="form-control form-control-sm" /></td>
                            <td><input @bind="line.ProductCode" class="form-control form-control-sm" /></td>
                            <td><input @bind="line.Quantity" type="number" class="form-control form-control-sm" style="width:70px" /></td>
                            <td><input @bind="line.UnitPrice" type="number" step="0.01" class="form-control form-control-sm" style="width:100px" /></td>
                            <td><input @bind="line.Discount" type="number" step="0.01" class="form-control form-control-sm" style="width:80px" /></td>
                            <td>
                                <select @bind="line.TaxRate" class="form-select form-select-sm">
                                    <option value="Standard">14%</option>
                                    <option value="Reduced">5%</option>
                                    <option value="Exempt">Isento</option>
                                    <option value="OutsideScope">Fora âmbito</option>
                                </select>
                            </td>
                            <td>
                                <select @bind="line.ExemptionReason" class="form-select form-select-sm">
                                    <option value="">-</option>
                                    <option value="M01">M01</option>
                                    <option value="M02">M02</option>
                                    <option value="M03">M03</option>
                                    <option value="M04">M04</option>
                                    <option value="M05">M05</option>
                                    <option value="M06">M06</option>
                                    <option value="M07">M07</option>
                                    <option value="M08">M08</option>
                                    <option value="M09">M09</option>
                                    <option value="M10">M10</option>
                                    <option value="M11">M11</option>
                                    <option value="M12">M12</option>
                                </select>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(line)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddLine"><i class="bi bi-plus-lg"></i> Adicionar Linha</button>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" @onclick="Save" disabled="@saving">
                    @if (saving) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                    else { <i class="bi bi-check-lg me-1"></i> }
                    Guardar
                </button>
                <a href="faturas" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancelar</a>
            </div>
        </form>
    </div>
</div>

@code {
    [Parameter] public int id { get; set; }
    private Invoice item = new();
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        if (id != 0)
            try { item = await Http.GetFromJsonAsync<Invoice>($"servicos/faturas/{id}") ?? new Invoice(); } catch (Exception ex) { error = $"Erro: {ex.Message}"; }
    }

    private void AddLine()
    {
        item.Lines.Add(new InvoiceLine());
    }

    private void RemoveLine(InvoiceLine line)
    {
        item.Lines.Remove(line);
    }

    private async Task Save()
    {
        try
        {
            saving = true;
            HttpResponseMessage response;
            if (id == 0) response = await Http.PostAsJsonAsync("servicos/faturas", item);
            else response = await Http.PutAsJsonAsync($"servicos/faturas/{id}", item);
            if (response.IsSuccessStatusCode)
                Nav.NavigateTo("faturas");
            else
                error = await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex) { error = $"Erro: {ex.Message}"; }
        finally { saving = false; }
    }
}
