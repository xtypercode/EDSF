@page "/login"
@inject AuthService Auth
@inject NavigationManager Navigation
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock display-4 text-primary"></i>
                    <h4 class="mt-2">Iniciar Sessão</h4>
                    <p class="text-muted small">EDSFR</p>
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger py-2 small">@error</div>
                }

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Utilizador</label>
                    <input @bind="username" class="form-control" placeholder="Username" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Password</label>
                    <input @bind="password" type="password" class="form-control" placeholder="Password"
                           @onkeydown="HandleEnter" />
                </div>
                <button class="btn btn-primary w-100" @onclick="DoLogin" disabled="@loading">
                    @if (loading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-box-arrow-in-right me-1"></i>Entrar
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string? error;
    private bool loading;

    private async Task HandleEnter(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoLogin();
    }

    private async Task DoLogin()
    {
        loading = true;
        error = null;
        try
        {
            var success = await Auth.LoginAsync(username, password);
            if (success)
                Navigation.NavigateTo("/", forceLoad: false);
            else
                error = "Credenciais inválidas.";
        }
        catch (Exception ex) { error = $"Erro: {ex.Message}"; }
        finally { loading = false; }
    }
}
