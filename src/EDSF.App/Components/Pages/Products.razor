@page "/produtos"
@inject HttpClient Http
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<div class="page-title">
    <span><i class="bi bi-box me-2"></i>Produtos</span>
    <div class="btn-group" role="group">
        <a href="produtos/novo" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Novo Produto</a>
        <button class="btn btn-outline-success" @onclick="ExportCsv"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Exportar CSV</button>
    </div>
</div>

<div class="filter-bar">
    <span class="text-muted small fw-semibold"><i class="bi bi-funnel me-1"></i>Filtrar:</span>
    <input @bind="searchTerm" class="form-control form-control-sm" style="width:200px" placeholder="Pesquisar..." 
           @onkeydown="() => Search()" />
    <button class="btn btn-sm btn-outline-primary" @onclick="Search"><i class="bi bi-search me-1"></i>Filtrar</button>
    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSearch"><i class="bi bi-x-lg me-1"></i></button>
</div>

@if (loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">A carregar...</p>
    </div>
}
else if (error != null)
{
    <div class="alert alert-danger">@error</div>
}
else if (items == null || items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-4 text-muted"></i>
            <p class="mt-3 text-muted">Nenhum registo encontrado.</p>
        </div>
    </div>
}
else
{

<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Nome</th><th>Preço</th><th>Stock</th><th class="text-end">Ações</th></tr></thead>
            <tbody>
                @foreach (var i in items ?? new())
                {
                    <tr>
                        <td><strong>@i.Name</strong></td>
                        <td>@i.Price.ToString("C")</td>
                        <td>
                            <span class="badge @(i.StockQuantity <= 5 ? "bg-danger" : i.StockQuantity <= 10 ? "bg-warning text-dark" : "bg-success")">@i.StockQuantity</span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-info" @onclick='() => Navigation.NavigateTo($"/armazem/produtos/{i.Id}")'><i class="bi bi-eye"></i></button>
                            <a href="produtos/@i.Id/editar" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(i.Id)"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination pagination-sm justify-content-center mt-3">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">Anterior</button>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Seguinte</button>
            </li>
        </ul>
    </nav>
}

}

@if (confirmDelete)
{
    <ConfirmDialog Title="Eliminar" Message="Tem a certeza?" OnConfirm="DoDelete" OnCancel="() => confirmDelete = false" />
}

@code {
    private List<Product>? items;
    private string? error;
    private bool confirmDelete;
    private int deleteId;
    private bool loading = true;
    private string searchTerm = "";
    private int currentPage = 1;
    private int totalPages = 1;
    private const int PageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        loading = false;
    }

    private async Task Load()
    {
        try
        {
            error = null;
            var url = $"armazem/produtos?page={currentPage}&pageSize={PageSize}";
            if (!string.IsNullOrEmpty(searchTerm))
                url += $"&search={Uri.EscapeDataString(searchTerm)}";
            var result = await Http.GetFromJsonAsync<PagedResult<Product>>(url);
            items = result?.Items;
            totalPages = result != null ? (int)Math.Ceiling((double)result.Total / PageSize) : 1;
        }
        catch (Exception ex) { error = $"Erro: {ex.Message}"; }
    }

    private async Task Search()
    {
        currentPage = 1;
        await Load();
    }

    private async Task ClearSearch()
    {
        searchTerm = "";
        currentPage = 1;
        await Load();
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await Load();
    }

    private async Task ExportCsv()
    {
        try
        {
            var response = await Http.GetAsync("armazem/produtos/export");
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JsRuntime.InvokeVoidAsync("downloadFile", $"produtos_{DateTime.Now:yyyyMMdd}.csv", base64);
            }
        }
        catch { }
    }

    private void Delete(int id) { confirmDelete = true; deleteId = id; }

    private async Task DoDelete() { try { confirmDelete = false; await Http.DeleteAsync($"armazem/produtos/{deleteId}"); await Load(); } catch (Exception ex) { error = $"Erro: {ex.Message}"; } }

}
