@page "/financas/novo"
@page "/financas/{id:int}/editar"
@inject HttpClient Http
@inject NavigationManager Nav

<div class="page-title">
    <span><i class="bi bi-pie-chart me-2"></i>@(id == 0 ? "NOVO REGISTO" : "EDITAR REGISTO")</span>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

<div class="card">
    <div class="card-body">
        <form>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Descrição</label>
                    <input @bind="item.Description" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tipo</label>
                    <select @bind="item.Type" class="form-select">
                        <option value="">Selecionar...</option>
                        <option value="Income">Receita</option>
                        <option value="Expense">Despesa</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Valor</label>
                    <input @bind="item.Amount" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Data</label>
                    <input @bind="item.Date" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Categoria</label>
                    <input @bind="item.Category" class="form-control" />
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" @onclick="Save" disabled="@saving">
                    @if (saving) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                    else { <i class="bi bi-check-lg me-1"></i> }
                    Guardar
                </button>
                <a href="financas" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancelar</a>
            </div>
        </form>
    </div>
</div>

@code {
    [Parameter] public int id { get; set; }
    private FinanceRecord item = new();
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        if (id != 0)
            try { item = await Http.GetFromJsonAsync<FinanceRecord>($"tesouraria/financas/{id}") ?? new FinanceRecord(); } catch (Exception ex) { error = $"Erro: {ex.Message}"; }
    }

    private async Task Save()
    {
        try
        {
            saving = true;
            HttpResponseMessage response;
            if (id == 0) response = await Http.PostAsJsonAsync("tesouraria/financas", item);
            else response = await Http.PutAsJsonAsync($"tesouraria/financas/{id}", item);
            if (response.IsSuccessStatusCode)
                Nav.NavigateTo("financas");
            else
                error = await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex) { error = $"Erro: {ex.Message}"; }
        finally { saving = false; }
    }
}
