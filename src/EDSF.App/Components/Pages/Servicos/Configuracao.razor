@page "/servicos/configuracao"
@inject HttpClient Http

<div class="page-title">
    <span><i class="bi bi-sliders me-2"></i>Configuração</span>
</div>

@if (error != null)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card">
    <div class="card-header">
        <i class="bi bi-wrench me-1"></i>Serviços Padrão
    </div>
    <div class="card-body">
        @if (servicosPadrao == null)
        {
            <div class="text-center py-3">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (servicosPadrao.Count == 0)
        {
            <p class="text-muted mb-0">Nenhum serviço padrão configurado.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th>Preço</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in servicosPadrao)
                        {
                            <tr>
                                <td><strong>@s.Name</strong></td>
                                <td>@s.Description</td>
                                <td>@s.Price.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private string? error;
    private List<Service>? servicosPadrao;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            servicosPadrao = await Http.GetFromJsonAsync<List<Service>>("servicos/configuracao/servicos-padrao");
        }
        catch (Exception ex)
        {
            error = $"Erro ao carregar serviços padrão: {ex.Message}";
        }
    }
}
