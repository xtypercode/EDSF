@page "/servicos/orcamentos/novo"
@page "/servicos/orcamentos/{id:int}/editar"
@inject HttpClient Http
@inject NavigationManager Nav

<div class="page-title">
    <span><i class="bi bi-file-earmark-text me-2"></i>@(id == 0 ? "NOVO ORÇAMENTO" : "EDITAR ORÇAMENTO")</span>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

<div class="card">
    <div class="card-body">
        <form>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Cliente ID</label>
                    <input @bind="item.CustomerId" type="number" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Data</label>
                    <input @bind="item.Date" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Estado</label>
                    <input @bind="item.Status" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Total</label>
                    <input @bind="item.TotalAmount" type="number" step="0.01" class="form-control" />
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" @onclick="Save" disabled="@saving">
                    @if (saving) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                    else { <i class="bi bi-check-lg me-1"></i> }
                    Guardar
                </button>
                <a href="servicos/orcamentos" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancelar</a>
            </div>
        </form>
    </div>
</div>

@code {
    [Parameter] public int id { get; set; }
    private Budget item = new();
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        if (id != 0)
            try { item = await Http.GetFromJsonAsync<Budget>($"servicos/orcamentos/{id}") ?? new Budget(); } catch (Exception ex) { error = $"Erro: {ex.Message}"; }
    }

    private async Task Save()
    {
        try
        {
            saving = true;
            HttpResponseMessage response;
            if (id == 0) response = await Http.PostAsJsonAsync("servicos/orcamentos", item);
            else response = await Http.PutAsJsonAsync($"servicos/orcamentos/{id}", item);
            if (response.IsSuccessStatusCode)
                Nav.NavigateTo("servicos/orcamentos");
            else
                error = await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex) { error = $"Erro: {ex.Message}"; }
        finally { saving = false; }
    }
}
