@page "/tesouraria/nota-credito/novo"
@page "/tesouraria/nota-credito/{id:int}/editar"
@inject HttpClient Http
@inject NavigationManager Nav

<div class="page-title">
    <span><i class="bi bi-file-earmark-plus me-2"></i>@(id == 0 ? "NOVA NOTA DE CRÉDITO" : "EDITAR NOTA DE CRÉDITO")</span>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

<div class="card">
    <div class="card-body">
        <form>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Número</label>
                    <input @bind="item.Number" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Valor</label>
                    <input @bind="item.Amount" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Data</label>
                    <input @bind="item.Date" type="date" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Motivo</label>
                    <textarea @bind="item.Reason" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" @onclick="Save" disabled="@saving">
                    @if (saving) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                    else { <i class="bi bi-check-lg me-1"></i> }
                    Guardar
                </button>
                <a href="tesouraria/nota-credito" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancelar</a>
            </div>
        </form>
    </div>
</div>

@code {
    [Parameter] public int id { get; set; }
    private CreditNote item = new();
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        if (id != 0)
            try { item = await Http.GetFromJsonAsync<CreditNote>($"tesouraria/notas-credito/{id}") ?? new CreditNote(); } catch (Exception ex) { error = $"Erro: {ex.Message}"; }
    }

    private async Task Save()
    {
        try
        {
            saving = true;
            HttpResponseMessage response;
            if (id == 0) response = await Http.PostAsJsonAsync("tesouraria/notas-credito", item);
            else response = await Http.PutAsJsonAsync($"tesouraria/notas-credito/{id}", item);
            if (response.IsSuccessStatusCode)
                Nav.NavigateTo("tesouraria/nota-credito");
            else
                error = await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex) { error = $"Erro: {ex.Message}"; }
        finally { saving = false; }
    }
}
