@page "/tesouraria/cadastro-basico"

<div class="page-title">
    <span><i class="bi bi-database me-2"></i>Cadastro Básico</span>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-file-earmark-minus display-6 text-danger"></i>
                <h5 class="mt-2">Notas de Débito</h5>
                <p class="text-muted">Gerir notas de débito</p>
                <a href="/tesouraria/nota-debito" class="btn btn-outline-danger"><i class="bi bi-arrow-right me-1"></i>Aceder</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-file-earmark-plus display-6 text-success"></i>
                <h5 class="mt-2">Notas de Crédito</h5>
                <p class="text-muted">Gerir notas de crédito</p>
                <a href="/tesouraria/nota-credito" class="btn btn-outline-success"><i class="bi bi-arrow-right me-1"></i>Aceder</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-credit-card display-6 text-primary"></i>
                <h5 class="mt-2">Notas de Pagamento</h5>
                <p class="text-muted">Gerir notas de pagamento</p>
                <a href="/tesouraria/nota-pagamento" class="btn btn-outline-primary"><i class="bi bi-arrow-right me-1"></i>Aceder</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-send display-6 text-info"></i>
                <h5 class="mt-2">Adiantamentos</h5>
                <p class="text-muted">Gerir adiantamentos</p>
                <a href="/tesouraria/adiantamento" class="btn btn-outline-info"><i class="bi bi-arrow-right me-1"></i>Aceder</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-cash-stack display-6 text-warning"></i>
                <h5 class="mt-2">Abertura de Caixa</h5>
                <p class="text-muted">Gerir abertura de caixa</p>
                <a href="/tesouraria/abertura-caixa" class="btn btn-outline-warning"><i class="bi bi-arrow-right me-1"></i>Aceder</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-file-earmark-spreadsheet display-6 text-secondary"></i>
                <h5 class="mt-2">SAFT-AGT</h5>
                <p class="text-muted">Declaração periódica</p>
                <a href="/tesouraria/saft-agt" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>Aceder</a>
            </div>
        </div>
    </div>
</div>

