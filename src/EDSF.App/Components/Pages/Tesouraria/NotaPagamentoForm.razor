@page "/tesouraria/nota-pagamento/novo"
@page "/tesouraria/nota-pagamento/{id:int}/editar"
@inject HttpClient Http
@inject NavigationManager Nav

<div class="page-title">
    <span><i class="bi bi-credit-card me-2"></i>@(id == 0 ? "NOVA NOTA DE PAGAMENTO" : "EDITAR NOTA DE PAGAMENTO")</span>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

<div class="card">
    <div class="card-body">
        <form>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Número</label>
                    <input @bind="item.Number" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cliente ID</label>
                    <input @bind="item.CustomerId" type="number" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fornecedor ID</label>
                    <input @bind="item.SupplierId" type="number" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Valor</label>
                    <input @bind="item.Amount" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Método</label>
                    <select @bind="item.Method" class="form-select">
                        <option value="Cash">Numerário</option>
                        <option value="BankTransfer">Transferência Bancária</option>
                        <option value="Multicaixa">Multicaixa</option>
                        <option value="Cheque">Cheque</option>
                        <option value="ATM">ATM</option>
                        <option value="Other">Outro</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Ref. Bancária</label>
                    <input @bind="item.BankReference" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Data</label>
                    <input @bind="item.Date" type="date" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Observações</label>
                    <textarea @bind="item.Notes" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" @onclick="Save" disabled="@saving">
                    @if (saving) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                    else { <i class="bi bi-check-lg me-1"></i> }
                    Guardar
                </button>
                <a href="tesouraria/nota-pagamento" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancelar</a>
            </div>
        </form>
    </div>
</div>

@code {
    [Parameter] public int id { get; set; }
    private PaymentNote item = new();
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        if (id != 0)
            try { item = await Http.GetFromJsonAsync<PaymentNote>($"tesouraria/notas-pagamento/{id}") ?? new PaymentNote(); } catch (Exception ex) { error = $"Erro: {ex.Message}"; }
    }

    private async Task Save()
    {
        try
        {
            saving = true;
            HttpResponseMessage response;
            if (id == 0) response = await Http.PostAsJsonAsync("tesouraria/notas-pagamento", item);
            else response = await Http.PutAsJsonAsync($"tesouraria/notas-pagamento/{id}", item);
            if (response.IsSuccessStatusCode)
                Nav.NavigateTo("tesouraria/nota-pagamento");
            else
                error = await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex) { error = $"Erro: {ex.Message}"; }
        finally { saving = false; }
    }
}
