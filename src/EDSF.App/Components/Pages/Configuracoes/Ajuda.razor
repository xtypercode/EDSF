@page "/configuracoes/ajuda"

<div class="page-title">
    <span><i class="bi bi-question-circle me-2"></i>Ajuda</span>
</div>

<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body text-center py-4">
                <i class="bi bi-box-seam display-1 text-primary"></i>
                <h3 class="mt-3">EDSF - Sistema de Gestão Empresarial</h3>
                <p class="text-muted">Versão 1.0.0</p>
                <p class="lead">Sistema integrado de gestão para empresas, incluindo módulos de Serviços, Armazém, Tesouraria, Contabilidade e Gestão.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-info-circle me-1"></i>Sobre</div>
            <div class="card-body">
                <p>O EDSF é uma plataforma completa de gestão empresarial que permite administrar clientes, produtos, stock, finanças e muito mais.</p>
                <p>Desenvolvido com Blazor WebAssembly e .NET.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-envelope me-1"></i>Contactos</div>
            <div class="card-body">
                <p class="mb-1"><i class="bi bi-globe me-2"></i><a href="#">www.edsf.ao</a></p>
                <p class="mb-1"><i class="bi bi-envelope me-2"></i><a href="mailto:suporte@edsf.ao">suporte@edsf.ao</a></p>
                <p class="mb-0"><i class="bi bi-telephone me-2"></i>+244 900 000 000</p>
            </div>
        </div>
    </div>
</div>

