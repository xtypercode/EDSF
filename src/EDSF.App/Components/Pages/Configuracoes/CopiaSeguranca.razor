@page "/configuracoes/copia-seguranca"
@inject HttpClient Http

<div class="page-title">
    <span><i class="bi bi-hdd me-2"></i>Cópia de Segurança</span>
</div>

@if (error != null)
{
    <div class="alert alert-danger">@error</div>
}

@if (success != null)
{
    <div class="alert alert-success">@success</div>
}

<div class="card">
    <div class="card-body text-center py-4">
        <i class="bi bi-hdd-stack display-1 text-primary"></i>
        <h4 class="mt-3">Cópia de Segurança</h4>
        <p class="text-muted">Crie uma cópia de segurança da base de dados atual.</p>
        <button class="btn btn-primary btn-lg" @onclick="CreateBackup" disabled="@loading">
            @if (loading)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <i class="bi bi-cloud-arrow-down me-1"></i>Criar Cópia
        </button>
        @if (backupPath != null)
        {
            <p class="mt-3 text-muted small">Ficheiro: @backupPath</p>
        }
    </div>
</div>

@code {
    private string? error;
    private string? success;
    private string? backupPath;
    private bool loading;

    private async Task CreateBackup()
    {
        loading = true;
        error = null;
        success = null;
        backupPath = null;
        try
        {
            var result = await Http.PostAsJsonAsync("configuracoes/backup/criar", new { });
            if (result.IsSuccessStatusCode)
            {
                var data = await result.Content.ReadFromJsonAsync<BackupResult>();
                if (data != null)
                {
                    success = $"Cópia criada com sucesso: {data.backup}";
                    backupPath = data.path;
                }
            }
            else
            {
                var msg = await result.Content.ReadAsStringAsync();
                error = $"Erro: {msg}";
            }
        }
        catch (Exception ex)
        {
            error = $"Erro ao criar cópia: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private record BackupResult(string backup, string path);
}
