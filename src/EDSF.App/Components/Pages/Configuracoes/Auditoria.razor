@page "/configuracoes/auditoria"
@using EDSF.Core.Models
@inject HttpClient Http
@inject NavigationManager Nav

<div class="page-title">
    <span><i class="bi bi-journal-text me-2"></i>Auditoria</span>
</div>

@if (error != null)
{
    <div class="alert alert-danger">@error</div>
}

<div class="filter-bar">
    <span class="text-muted small fw-semibold"><i class="bi bi-funnel me-1"></i>Filtrar:</span>
    <input @bind="searchEntity" class="form-control form-control-sm" style="width:160px" placeholder="Entidade..." />
    <input @bind="searchAction" class="form-control form-control-sm" style="width:120px" placeholder="Ação..." />
    <button class="btn btn-sm btn-outline-primary" @onclick="LoadData"><i class="bi bi-search me-1"></i>Filtrar</button>
</div>

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted small">A carregar auditoria...</p>
    </div>
}
else if (logs == null || logs.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-4 text-muted"></i>
            <p class="mt-3 text-muted">Nenhum registo de auditoria encontrado.</p>
        </div>
    </div>
}
else
{
    <div class="card table-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Data/Hora</th>
                        <th>Entidade</th>
                        <th>ID</th>
                        <th>Ação</th>
                        <th>Utilizador</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in logs)
                    {
                        <tr>
                            <td class="text-nowrap">@log.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@log.EntityName</td>
                            <td>@log.EntityId</td>
                            <td>
                                <span class="badge @(log.Action == "Create" ? "bg-success" : log.Action == "Update" ? "bg-warning text-dark" : "bg-danger")">
                                    @(log.Action == "Create" ? "Criação" : log.Action == "Update" ? "Alteração" : "Eliminação")
                                </span>
                            </td>
                            <td>@log.UserName</td>
                            <td>
                                <button class="btn btn-sm btn-outline-info" @onclick="() => ShowDetail(log)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm justify-content-center mt-3">
                <li class="page-item @(page == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(page - 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                    </li>
                }
                <li class="page-item @(page == totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(page + 1)">Seguinte</button>
                </li>
            </ul>
        </nav>
    }
}

@if (showDetail && selectedLog != null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-journal-text me-1"></i>Detalhe da Auditoria</h5>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Entidade</dt>
                        <dd class="col-sm-9">@selectedLog.EntityName</dd>
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9">@selectedLog.EntityId</dd>
                        <dt class="col-sm-3">Ação</dt>
                        <dd class="col-sm-9"><span class="badge @(selectedLog.Action == "Create" ? "bg-success" : selectedLog.Action == "Update" ? "bg-warning text-dark" : "bg-danger")">@selectedLog.Action</span></dd>
                        <dt class="col-sm-3">Data/Hora</dt>
                        <dd class="col-sm-9">@selectedLog.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</dd>
                        <dt class="col-sm-3">Utilizador</dt>
                        <dd class="col-sm-9">@selectedLog.UserName</dd>
                    </dl>
                    @if (!string.IsNullOrEmpty(selectedLog.OldValues))
                    {
                        <h6 class="mt-3">Valores Antigos</h6>
                        <pre class="bg-light p-2 rounded" style="font-size:0.8rem;max-height:200px;overflow:auto;">@FormatJson(selectedLog.OldValues)</pre>
                    }
                    @if (!string.IsNullOrEmpty(selectedLog.NewValues))
                    {
                        <h6 class="mt-3">Valores Novos</h6>
                        <pre class="bg-light p-2 rounded" style="font-size:0.8rem;max-height:200px;overflow:auto;">@FormatJson(selectedLog.NewValues)</pre>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseDetail"><i class="bi bi-x-lg me-1"></i>Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AuditLog>? logs;
    private string? error;
    private bool loading = true;
    private string searchEntity = "";
    private string searchAction = "";
    private int page = 1;
    private int totalPages = 1;
    private const int PageSize = 25;
    private bool showDetail;
    private AuditLog? selectedLog;

    private void ShowDetail(AuditLog log) { selectedLog = log; showDetail = true; }
    private void CloseDetail() { showDetail = false; selectedLog = null; }

    private string FormatJson(string json)
    {
        try
        {
            var obj = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(json);
            return System.Text.Json.JsonSerializer.Serialize(obj, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch { return json; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        loading = false;
    }

    private async Task GoToPage(int p)
    {
        page = p;
        loading = true;
        StateHasChanged();
        await LoadData();
        loading = false;
        StateHasChanged();
    }

    private async Task LoadData()
    {
        try
        {
            error = null;
            var query = $"configuracoes/auditoria?page={page}&pageSize={PageSize}";
            if (!string.IsNullOrEmpty(searchEntity)) query += $"&entityName={Uri.EscapeDataString(searchEntity)}";
            if (!string.IsNullOrEmpty(searchAction)) query += $"&action={Uri.EscapeDataString(searchAction)}";
            var result = await Http.GetFromJsonAsync<AuditLogResult>(query);
            if (result != null)
            {
                logs = result.Items?.ToList() ?? new();
                totalPages = (int)Math.Ceiling((double)result.Total / PageSize);
                if (totalPages < 1) totalPages = 1;
            }
        }
        catch (Exception ex) { error = $"Erro: {ex.Message}"; }
    }

    private record AuditLogResult(List<AuditLog> Items, int Total);
}
