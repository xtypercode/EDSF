@page "/configuracoes/dados-empresa"
@inject HttpClient Http
@inject NavigationManager Nav

<div class="page-title">
    <span><i class="bi bi-building me-2"></i>Dados da Empresa</span>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

<div class="card">
    <div class="card-body">
        <form>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nome</label>
                    <input @bind="item.Name" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">NIF</label>
                    <input @bind="item.Nif" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Regime IVA</label>
                    <select @bind="item.TaxRegime" class="form-select">
                        <option value="Simplified">Simplificado</option>
                        <option value="General">Geral</option>
                        <option value="Exempt">Isento</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Telefone</label>
                    <input @bind="item.Phone" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input @bind="item.Email" type="email" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Morada</label>
                    <textarea @bind="item.Address" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Província</label>
                    <select @bind="item.Province" class="form-select">
                        <option value="">-</option>
                        <option value="Bengo">Bengo</option>
                        <option value="Benguela">Benguela</option>
                        <option value="Bie">Bié</option>
                        <option value="Cabinda">Cabinda</option>
                        <option value="CuandoCubango">Cuando Cubango</option>
                        <option value="CuanzaNorte">Cuanza Norte</option>
                        <option value="CuanzaSul">Cuanza Sul</option>
                        <option value="Cunene">Cunene</option>
                        <option value="Huambo">Huambo</option>
                        <option value="Huila">Huíla</option>
                        <option value="Luanda">Luanda</option>
                        <option value="LundaNorte">Lunda Norte</option>
                        <option value="LundaSul">Lunda Sul</option>
                        <option value="Malanje">Malanje</option>
                        <option value="Moxico">Moxico</option>
                        <option value="Namibe">Namibe</option>
                        <option value="Uige">Uíge</option>
                        <option value="Zaire">Zaire</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Município</label>
                    <input @bind="item.Municipality" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Comuna</label>
                    <input @bind="item.Commune" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Registo Comercial</label>
                    <input @bind="item.CommercialReg" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">CAE</label>
                    <input @bind="item.Cae" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Capital Social</label>
                    <input @bind="item.CapitalSocial" type="number" step="0.01" class="form-control" />
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" @onclick="Save" disabled="@saving">
                    @if (saving) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                    else { <i class="bi bi-check-lg me-1"></i> }
                    Guardar
                </button>
                <a href="/" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancelar</a>
            </div>
        </form>
    </div>
</div>

@code {
    private CompanyData item = new();
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        try { item = await Http.GetFromJsonAsync<CompanyData>("configuracoes/empresa") ?? new CompanyData(); } catch (Exception ex) { error = $"Erro: {ex.Message}"; }
    }

    private async Task Save()
    {
        try
        {
            saving = true;
            var response = await Http.PutAsJsonAsync("configuracoes/empresa", item);
            if (response.IsSuccessStatusCode)
                Nav.NavigateTo("/");
            else
                error = await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex) { error = $"Erro: {ex.Message}"; }
        finally { saving = false; }
    }
}
