@page "/stock/novo"
@page "/stock/{id:int}/editar"
@inject HttpClient Http
@inject NavigationManager Nav

<div class="page-title">
    <span><i class="bi bi-boxes me-2"></i>@(id == 0 ? "NOVO MOVIMENTO" : "EDITAR MOVIMENTO")</span>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

<div class="card">
    <div class="card-body">
        <form>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Produto ID</label>
                    <input @bind="item.ProductId" type="number" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tipo</label>
                    <select @bind="item.Type" class="form-select">
                        <option value="">Selecionar...</option>
                        <option value="In">Entrada</option>
                        <option value="Out">Saída</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Quantidade</label>
                    <input @bind="item.Quantity" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Data</label>
                    <input @bind="item.Date" type="date" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Notas</label>
                    <textarea @bind="item.Notes" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" @onclick="Save" disabled="@saving">
                    @if (saving) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                    else { <i class="bi bi-check-lg me-1"></i> }
                    Guardar
                </button>
                <a href="stock" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancelar</a>
            </div>
        </form>
    </div>
</div>

@code {
    [Parameter] public int id { get; set; }
    private StockMovement item = new();
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        if (id != 0)
            try { item = await Http.GetFromJsonAsync<StockMovement>($"armazem/stock/{id}") ?? new StockMovement(); } catch (Exception ex) { error = $"Erro: {ex.Message}"; }
    }

    private async Task Save()
    {
        try
        {
            saving = true;
            HttpResponseMessage response;
            if (id == 0) response = await Http.PostAsJsonAsync("armazem/stock", item);
            else response = await Http.PutAsJsonAsync($"armazem/stock/{id}", item);
            if (response.IsSuccessStatusCode)
                Nav.NavigateTo("stock");
            else
                error = await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex) { error = $"Erro: {ex.Message}"; }
        finally { saving = false; }
    }
}
