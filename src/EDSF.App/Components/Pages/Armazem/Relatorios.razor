@page "/armazem/relatorios"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="page-title">
    <span><i class="bi bi-bar-chart me-2"></i>Relatórios de Armazém</span>
</div>

@if (error != null)
{
    <div class="alert alert-danger">@error</div>
}

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted small">A carregar relatórios...</p>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card kpi-card" style="border-left-color: var(--primary);">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--primary);"><i class="bi bi-boxes"></i></div>
                    <div>
                        <div class="kpi-value">@stockItems?.Count ?? 0</div>
                        <div class="kpi-label">Itens em Stock</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card kpi-card" style="border-left-color: var(--success);">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--success);"><i class="bi bi-box"></i></div>
                    <div>
                        <div class="kpi-value">@stockItems?.Sum(i => i.Quantity) ?? 0</div>
                        <div class="kpi-label">Qtd Total</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card kpi-card" style="border-left-color: var(--info);">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--info);"><i class="bi bi-arrow-left-right"></i></div>
                    <div>
                        <div class="kpi-value">@movimentos?.Count ?? 0</div>
                        <div class="kpi-label">Movimentos</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card kpi-card" style="border-left-color: var(--warning);">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--warning);"><i class="bi bi-geo-alt"></i></div>
                    <div>
                        <div class="kpi-value">@(stockItems?.Select(i => i.Location).Distinct().Count() ?? 0)</div>
                        <div class="kpi-label">Localizações</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><i class="bi bi-bar-chart me-1"></i>Stock por Produto (Top 10)</div>
                <div class="card-body">
                    <canvas id="stockBarChart" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><i class="bi bi-pie-chart me-1"></i>Distribuição por Localização</div>
                <div class="card-body">
                    <canvas id="locationDoughnutChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><i class="bi bi-boxes me-1"></i>Stock Atual</div>
                <div class="card-body">
                    @if (stockItems == null || stockItems.Count == 0)
                    {
                        <p class="text-muted mb-0">Nenhum item em stock.</p>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 300px;">
                            <table class="table table-sm table-hover mb-0">
                                <thead>
                                    <tr><th>Código</th><th>Nome</th><th>Qtd</th><th>Local</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var i in stockItems)
                                    {
                                        <tr>
                                            <td>@i.Code</td>
                                            <td>@i.Name</td>
                                            <td><span class="badge bg-info">@i.Quantity</span></td>
                                            <td>@i.Location</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><i class="bi bi-arrow-left-right me-1"></i>Movimentos Recentes</div>
                <div class="card-body">
                    @if (movimentos == null || movimentos.Count == 0)
                    {
                        <p class="text-muted mb-0">Nenhum movimento registado.</p>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 300px;">
                            <table class="table table-sm table-hover mb-0">
                                <thead>
                                    <tr><th>Produto</th><th>Tipo</th><th>Qtd</th><th>Data</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in movimentos.OrderByDescending(m => m.Date).Take(10))
                                    {
                                        <tr>
                                            <td>@m.Product?.Name ?? $"ID: {m.ProductId}"</td>
                                            <td><span class="badge @(m.Type == MovementType.In ? "bg-success" : "bg-danger")">@(m.Type == MovementType.In ? "Entrada" : "Saída")</span></td>
                                            <td>@m.Quantity</td>
                                            <td>@m.Date.ToShortDateString()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string? error;
    private bool loading = true;
    private List<StockItemDto>? stockItems;
    private List<StockMovement>? movimentos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            stockItems = await Http.GetFromJsonAsync<List<StockItemDto>>("armazem/relatorios/stock-atual");
            movimentos = await Http.GetFromJsonAsync<List<StockMovement>>("armazem/relatorios/movimentos");
        }
        catch (Exception ex)
        {
            error = $"Erro ao carregar relatórios: {ex.Message}";
        }
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Task.Delay(100);

        if (stockItems != null && stockItems.Count > 0)
        {
            var top10 = stockItems.OrderByDescending(i => i.Quantity).Take(10).ToList();
            await JS.InvokeVoidAsync("dashboard.createBar", "stockBarChart",
                top10.Select(i => i.Name.Length > 15 ? i.Name[..15] + "..." : i.Name).ToArray(),
                top10.Select(i => i.Quantity).ToArray(), "Stock");

            var byLocation = stockItems.GroupBy(i => i.Location)
                .Select(g => new { loc = string.IsNullOrEmpty(g.Key) ? "Sem local" : g.Key, qty = g.Sum(i => i.Quantity) })
                .ToList();
            await JS.InvokeVoidAsync("dashboard.createDoughnut", "locationDoughnutChart",
                byLocation.Select(i => i.loc).ToArray(),
                byLocation.Select(i => i.qty).ToArray());
        }
    }

    private record StockItemDto(string Code, string Name, int Quantity, string Location);
}
