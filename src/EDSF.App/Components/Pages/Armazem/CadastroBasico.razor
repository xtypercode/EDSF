@page "/armazem/cadastro-basico"

<div class="page-title">
    <span><i class="bi bi-database me-2"></i>Cadastro Básico</span>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-box display-6 text-primary"></i>
                <h5 class="mt-2">Produtos</h5>
                <p class="text-muted">Gerir produtos do armazém</p>
                <a href="/produtos" class="btn btn-outline-primary"><i class="bi bi-arrow-right me-1"></i>Aceder</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-boxes display-6 text-success"></i>
                <h5 class="mt-2">Itens do Armazém</h5>
                <p class="text-muted">Itens e localizações</p>
                <a href="/armazem/itens" class="btn btn-outline-success"><i class="bi bi-arrow-right me-1"></i>Aceder</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-truck display-6 text-warning"></i>
                <h5 class="mt-2">Fornecedores</h5>
                <p class="text-muted">Gerir fornecedores</p>
                <a href="/armazem/fornecedores" class="btn btn-outline-warning"><i class="bi bi-arrow-right me-1"></i>Aceder</a>
            </div>
        </div>
    </div>
</div>

