@page "/produtos/novo"
@page "/produtos/{id:int}/editar"
@inject HttpClient Http
@inject NavigationManager Nav

<div class="page-title">
    <span><i class="bi bi-box me-2"></i>@(id == 0 ? "NOVO PRODUTO" : "EDITAR PRODUTO")</span>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

<div class="card">
    <div class="card-body">
        <form>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nome</label>
                    <input @bind="item.Name" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Preço</label>
                    <input @bind="item.Price" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Stock</label>
                    <input @bind="item.StockQuantity" type="number" class="form-control" />
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" @onclick="Save" disabled="@saving">
                    @if (saving) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                    else { <i class="bi bi-check-lg me-1"></i> }
                    Guardar
                </button>
                <a href="produtos" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancelar</a>
            </div>
        </form>
    </div>
</div>

@code {
    [Parameter] public int id { get; set; }
    private Product item = new();
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        if (id != 0) try { item = await Http.GetFromJsonAsync<Product>($"armazem/produtos/{id}") ?? new Product(); } catch (Exception ex) { error = $"Erro: {ex.Message}"; }
    }

    private async Task Save()
    {
        try
        {
            saving = true;
            HttpResponseMessage response;
            if (id == 0) response = await Http.PostAsJsonAsync("armazem/produtos", item);
            else response = await Http.PutAsJsonAsync($"armazem/produtos/{id}", item);
            if (response.IsSuccessStatusCode)
                Nav.NavigateTo("produtos");
            else
                error = await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex) { error = $"Erro: {ex.Message}"; }
        finally { saving = false; }
    }
}
