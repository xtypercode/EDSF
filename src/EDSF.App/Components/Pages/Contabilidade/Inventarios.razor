@page "/contabilidade/inventarios"
@inject HttpClient Http

<div class="page-title">
    <span><i class="bi bi-clipboard-data me-2"></i>Inventários</span>
</div>

@if (loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">A carregar...</p>
    </div>
}
else if (error != null) { <div class="alert alert-danger">@error</div> }
else if (items == null || items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-4 text-muted"></i>
            <p class="mt-3 text-muted">Nenhum registo encontrado.</p>
        </div>
    </div>
}
else
{

<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Data</th><th>Notas</th><th>Itens</th></tr></thead>
            <tbody>
                @foreach (var i in items ?? new())
                {
                    <tr>
                        <td>@i.Date.ToShortDateString()</td>
                        <td>@i.Notes</td>
                        <td>@(i.Items?.Count ?? 0)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

}

@code {
    private List<Inventory>? items;
    private string? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        loading = false;
    }

    private async Task Load() { try { error = null; items = await Http.GetFromJsonAsync<List<Inventory>>("contabilidade/inventarios"); } catch (Exception ex) { error = $"Erro: {ex.Message}"; } }
}
