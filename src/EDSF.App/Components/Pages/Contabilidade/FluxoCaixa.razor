@page "/contabilidade/fluxo-caixa"
@inject HttpClient Http

<div class="page-title">
    <span><i class="bi bi-arrow-left-right me-2"></i>Fluxo de Caixa</span>
</div>

@if (loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted small">A carregar...</p>
    </div>
}
else if (error != null)
{
    <div class="alert alert-danger">@error</div>
}
else if (movimentos == null || movimentos.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-4 text-muted"></i>
            <p class="mt-3 text-muted">Nenhum movimento encontrado.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card kpi-card" style="border-left-color: var(--success);">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--success);"><i class="bi bi-arrow-down-circle"></i></div>
                    <div>
                        <div class="kpi-value text-success">@String.Format("{0:C}", entradas)</div>
                        <div class="kpi-label">Entradas</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card kpi-card" style="border-left-color: var(--danger);">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--danger);"><i class="bi bi-arrow-up-circle"></i></div>
                    <div>
                        <div class="kpi-value text-danger">@String.Format("{0:C}", saidas)</div>
                        <div class="kpi-label">Saídas</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card kpi-card" style="border-left-color: var(--info);">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--info);"><i class="bi bi-arrow-left-right"></i></div>
                    <div>
                        <div class="kpi-value text-info">@String.Format("{0:C}", entradas - saidas)</div>
                        <div class="kpi-label">Saldo</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card table-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Descrição</th>
                        <th>Tipo</th>
                        <th>Valor</th>
                        <th>Data</th>
                        <th>Categoria</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in movimentos)
                    {
                        <tr>
                            <td>@i.Description</td>
                            <td>
                                <span class="badge @(i.Amount > 0 ? "bg-success" : "bg-danger")">@(i.Amount > 0 ? "Entrada" : "Saída")</span>
                            </td>
                            <td>@i.Amount.ToString("C")</td>
                            <td>@i.Date.ToShortDateString()</td>
                            <td>@i.Category</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<FinanceRecord>? movimentos;
    private decimal entradas;
    private decimal saidas;
    private string? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        loading = false;
    }

    private async Task Load()
    {
        try
        {
            error = null;
            var result = await Http.GetFromJsonAsync<FluxoCaixaDto>("contabilidade/fluxo-caixa");
            if (result != null)
            {
                entradas = result.entradas;
                saidas = result.saidas;
                movimentos = result.movimentos?.ToList() ?? new();
            }
        }
        catch (Exception ex)
        {
            error = $"Erro: {ex.Message}";
        }
    }

    private record FluxoCaixaDto(decimal entradas, decimal saidas, List<FinanceRecord>? movimentos);
}
