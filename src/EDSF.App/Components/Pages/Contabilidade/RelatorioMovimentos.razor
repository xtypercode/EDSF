@page "/contabilidade/relatorio-movimentos"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="page-title">
    <span><i class="bi bi-file-earmark-bar-graph me-2"></i>Relatório de Movimentos</span>
</div>

@if (loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted small">A carregar...</p>
    </div>
}
else if (error != null)
{
    <div class="alert alert-danger">@error</div>
}
else if ((stockMovements == null || stockMovements.Count == 0) && (financeRecords == null || financeRecords.Count == 0))
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-4 text-muted"></i>
            <p class="mt-3 text-muted">Nenhum movimento encontrado.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card kpi-card" style="border-left-color: var(--primary);">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--primary);"><i class="bi bi-box"></i></div>
                    <div>
                        <div class="kpi-value">@(stockMovements?.Count ?? 0)</div>
                        <div class="kpi-label">Mov. Stock</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card kpi-card" style="border-left-color: var(--success);">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--success);"><i class="bi bi-cash"></i></div>
                    <div>
                        <div class="kpi-value">@(financeRecords?.Count ?? 0)</div>
                        <div class="kpi-label">Mov. Financeiros</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card kpi-card" style="border-left-color: var(--info);">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--info);"><i class="bi bi-arrow-down-circle"></i></div>
                    <div>
                        <div class="kpi-value">@(stockMovements?.Count(m => m.Type == MovementType.In) ?? 0)</div>
                        <div class="kpi-label">Entradas Stock</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card kpi-card" style="border-left-color: var(--danger);">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--danger);"><i class="bi bi-arrow-up-circle"></i></div>
                    <div>
                        <div class="kpi-value">@(stockMovements?.Count(m => m.Type == MovementType.Out) ?? 0)</div>
                        <div class="kpi-label">Saídas Stock</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><i class="bi bi-pie-chart me-1"></i>Movimentos de Stock</div>
                <div class="card-body">
                    <canvas id="stockMoveDoughnutChart" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><i class="bi bi-pie-chart me-1"></i>Movimentos Financeiros</div>
                <div class="card-body">
                    <canvas id="finMoveDoughnutChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><i class="bi bi-box me-1"></i>Movimentos de Stock</div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Produto</th><th>Tipo</th><th>Quantidade</th><th>Data</th></tr></thead>
                        <tbody>
                            @foreach (var i in stockMovements ?? new())
                            {
                                <tr>
                                    <td>@(i.Product?.Name ?? $"ID: {i.ProductId}")</td>
                                    <td><span class="badge @(i.Type == MovementType.In ? "bg-success" : "bg-danger")">@(i.Type == MovementType.In ? "Entrada" : "Saída")</span></td>
                                    <td>@i.Quantity</td>
                                    <td>@i.Date.ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><i class="bi bi-cash me-1"></i>Movimentos Financeiros</div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Descrição</th><th>Tipo</th><th>Valor</th><th>Data</th></tr></thead>
                        <tbody>
                            @foreach (var i in financeRecords ?? new())
                            {
                                <tr>
                                    <td>@i.Description</td>
                                    <td><span class="badge @(i.Type == FinanceType.Income ? "bg-success" : "bg-danger")">@(i.Type == FinanceType.Income ? "Receita" : "Despesa")</span></td>
                                    <td>@i.Amount.ToString("C")</td>
                                    <td>@i.Date.ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<StockMovement>? stockMovements;
    private List<FinanceRecord>? financeRecords;
    private string? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        loading = false;
    }

    private async Task Load()
    {
        try
        {
            error = null;
            var result = await Http.GetFromJsonAsync<RelatorioMovimentosDto>("contabilidade/relatorio-movimentos");
            if (result != null)
            {
                stockMovements = result.stockMovements?.ToList() ?? new();
                financeRecords = result.financeRecords?.ToList() ?? new();
            }
        }
        catch (Exception ex)
        {
            error = $"Erro: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Task.Delay(100);

        if (stockMovements != null && stockMovements.Count > 0)
        {
            var entradas = stockMovements.Count(m => m.Type == MovementType.In);
            var saidas = stockMovements.Count(m => m.Type == MovementType.Out);
            await JS.InvokeVoidAsync("dashboard.createDoughnut", "stockMoveDoughnutChart",
                new[] { "Entradas", "Saídas" },
                new[] { entradas, saidas });
        }

        if (financeRecords != null && financeRecords.Count > 0)
        {
            var receitas = financeRecords.Where(r => r.Type == FinanceType.Income).Sum(r => Math.Abs(r.Amount));
            var despesas = financeRecords.Where(r => r.Type == FinanceType.Expense).Sum(r => Math.Abs(r.Amount));
            await JS.InvokeVoidAsync("dashboard.createDoughnut", "finMoveDoughnutChart",
                new[] { "Receitas", "Despesas" },
                new[] { receitas, despesas });
        }
    }

    private record RelatorioMovimentosDto(List<StockMovement>? stockMovements, List<FinanceRecord>? financeRecords);
}
